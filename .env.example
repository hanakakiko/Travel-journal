# ⚠️ 重要：API Key 配置说明
#
# 本项目支持三种方式配置 API Key（优先级从高到低）：
# 1. 环境变量（.env 文件）- 最高优先级
# 2. 本地配置文件（src/lib/api-keys.local.ts）- 中等优先级，已在 .gitignore 中
# 3. UI 配置面板 - 最低优先级，存储在 localStorage
#
# 推荐开发时使用方式 2（本地配置文件），生产环境使用方式 1（环境变量）

# Replicate API Token
# 获取方式：https://replicate.com/account/api-tokens
# 用于调用 FLUX.2 Pro 模型进行图生图
# VITE_REPLICATE_API_TOKEN=your_replicate_api_token_here

# Kratos API Token（可选）
# 用于调用小红书内部 Kratos 平台的 GPT-2 模型
# 获取方式：联系管理员 叶瑄（丁江颖）
# VITE_KRATOS_API_TOKEN=your_kratos_api_token_here

# QS GPT Image 2 API Key（可选）
# 用于调用小红书 QS 平台的 GPT Image 2 模型
# 获取方式：联系管理员 叶瑄（丁江颖）
# VITE_QS_GPT_IMAGE_2_API_KEY=your_qs_gpt_image_2_api_key_here

# Kratos 接口地址（可选，默认使用本地代理）
# VITE_KRATOS_ACTION_URL=http://kratos-sunyihao.sl.beta.xiaohongshu.com/ads/materialcenter/doaction

# MAAS 平台配置（用于视觉大模型 qwen3-vl-32b-instruct）
# VITE_MAAS_API_KEY=your_maas_api_key_here
# VITE_MAAS_USER_EMAIL=your_email@xiaohongshu.com
# VITE_MAAS_APP_ID=qs-api
# VITE_MAAS_BASE=https://maas.devops.xiaohongshu.com

# CloudBase 生产部署开关（非敏感）
# 生产构建默认走 CloudBase 云函数代理与云存储；本地 dev 默认仍走 Vite 代理/COS。
# 如果想本地也测试 CloudBase 路径，可以在 .env.local 中打开：
# VITE_USE_CLOUDBASE_MODEL_PROXY=true
# VITE_UPLOAD_PROVIDER=cloudbase
#
# 可选：隐藏未列出的模型按钮，多个模型用英文逗号分隔。
# 不配置时会展示全部模型按钮；非 V-API 模型没有 Key 时会置灰。
# VITE_CLOUDBASE_AVAILABLE_MODELS=v-api-gpt-image-2,v-api-seedream-4-5
